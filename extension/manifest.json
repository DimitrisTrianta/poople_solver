{
  "manifest_version": 3,
  "name": "Poople Solver",
  "version": "1.1",
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://poople.io/*"], 
      "js": ["scraper.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pkg/*"],
      "matches": ["https://poople.io/*"]
    }
  ]
}